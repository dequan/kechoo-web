---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfqPanel from '../../components/RfqPanel.astro';
import { applications, technologies } from '../../data/site';
import { products, type Product } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const application = applications.find((item) => item.slug === product.application);
const technology = technologies.find((item) => item.slug === product.technology);
const relatedProducts = products
  .filter((item) => item.slug !== product.slug && (item.application === product.application || item.technology === product.technology))
  .slice(0, 3);
const quoteChecklist = [
  `Confirm machine accepts ${product.length} x ${product.width} x ${product.thickness}`,
  `Check the equivalent market size: ${product.imperialSize}`,
  `Confirm the workpiece is close to: ${product.cutMaterial}`,
  `Send current blade photo or package if replacing an existing blade`,
  'Share quantity, destination country and buyer type'
];
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  sku: product.sku,
  brand: { '@type': 'Brand', name: 'Band Saw Blade Supply' },
  category: `${technology?.title} bandsaw blade`,
  description: product.selectionRationale,
  material: [product.backingMaterial, product.toothMaterial],
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Application', value: application?.title },
    { '@type': 'PropertyValue', name: 'Market title', value: product.marketTitle },
    { '@type': 'PropertyValue', name: 'Blade length', value: product.length },
    { '@type': 'PropertyValue', name: 'Blade width', value: product.width },
    { '@type': 'PropertyValue', name: 'Blade thickness', value: product.thickness },
    { '@type': 'PropertyValue', name: 'Imperial equivalent', value: product.imperialSize },
    { '@type': 'PropertyValue', name: 'Tooth pitch', value: product.toothPitch },
    { '@type': 'PropertyValue', name: 'Machine type', value: product.machine }
  ]
};
---

<BaseLayout
  title={`${product.name} quotation`}
  description={`${product.name}. ${product.selectionRationale} Send SKU ${product.sku} for price, MOQ and lead time.`}
  structuredData={productSchema}
>
  <main id="main-content">
    <header class="page-hero">
      <nav class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / {product.sku}</nav>
      <p class="page-label">{technology?.title} / {application?.title}</p>
      <h1>{product.name}</h1>
      <p>{product.marketTitle}. {product.selectionRationale}</p>
    </header>

    <section class="section product-detail">
      <div class="product-detail__main">
        <div class="product-summary">
          <h2>Recommended use</h2>
          <p>{product.recommendedRange}</p>
          <p>Use this specification as a starting point. We confirm machine fit, MOQ, pack quantity and lead time before issuing a quotation.</p>
          <ul class="alias-list">
            {product.sizeAliases.map((alias) => <li>{alias}</li>)}
          </ul>
        </div>
        <dl class="spec-list">
          <div><dt>SKU</dt><dd>{product.sku}</dd></div>
          <div><dt>Market title</dt><dd>{product.marketTitle}</dd></div>
          <div><dt>Application</dt><dd>{application?.title}</dd></div>
          <div><dt>Technology</dt><dd>{technology?.title}</dd></div>
          <div><dt>Cut material</dt><dd>{product.cutMaterial}</dd></div>
          <div><dt>Machine type</dt><dd>{product.machine}</dd></div>
          <div><dt>Blade size</dt><dd>{product.length} x {product.width} x {product.thickness}</dd></div>
          <div><dt>Imperial equivalent</dt><dd>{product.imperialSize}</dd></div>
          <div><dt>Tooth pitch</dt><dd>{product.toothPitch}</dd></div>
          <div><dt>Tooth form</dt><dd>{product.toothForm}</dd></div>
          <div><dt>Backing material</dt><dd>{product.backingMaterial}</dd></div>
          <div><dt>Tooth material</dt><dd>{product.toothMaterial}</dd></div>
          <div><dt>Recommended range</dt><dd>{product.recommendedRange}</dd></div>
          <div><dt>Pack quantity</dt><dd>{product.packQuantity}</dd></div>
          <div><dt>Custom size</dt><dd>{product.customSize}</dd></div>
        </dl>
      </div>
      <aside class="detail-panel">
        <p class="page-label">Confirm before order</p>
        <h2>Confirm fit before purchase</h2>
        <p>For bandsaw blades, the wrong length or tooth pitch creates waste quickly. Band Saw Blade Supply confirms compatibility, MOQ, lead time and shipment details before quotation.</p>
        <ul class="dense-list">
          {quoteChecklist.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button" href={`/request-a-quote/?sku=${product.sku}`}>Request quotation</a>
      </aside>
    </section>

    <section class="section section--gray" aria-labelledby="selection-title">
      <div class="section__inner split-panels">
        <article>
          <h2 id="selection-title">Why buyers choose this specification</h2>
          <p>{product.selectionRationale}</p>
          <p>Confirm machine fit, cutting material and order quantity before using it as a replacement blade.</p>
        </article>
        <article>
          <h2>When to request custom review</h2>
          <ul class="dense-list">
            <li>Your machine label shows a different loop length or blade width.</li>
            <li>Your cutting material is harder, larger or more abrasive than the recommended range.</li>
            <li>You need distributor packing, OEM label, trial quantity or repeat supply planning.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="use-case-title">
      <div class="split-panels">
        <article>
          <h2 id="use-case-title">Use cases</h2>
          <ul class="dense-list">
            {product.useCases.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h2>Machine compatibility notes</h2>
          <ul class="dense-list">
            {product.compatibleMachines.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h2>Selection notes</h2>
          <ul class="dense-list">
            {product.selectionNotes.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h2>Other common names</h2>
          <ul class="query-list">
            {product.searchPhrases.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    {relatedProducts.length > 0 && (
      <section class="section" aria-labelledby="related-products">
        <div class="section-heading">
          <h2 id="related-products">Related specifications</h2>
          <p>Compare nearby products before sending your quotation request.</p>
        </div>
        <div class="product-grid">
          {relatedProducts.map((item) => (
            <article class="product-card">
              <div class="product-card__meta"><span>{item.sku}</span></div>
              <h3><a href={`/products/${item.slug}/`}>{item.name}</a></h3>
              <p>{item.selectionRationale}</p>
              <a class="text-link" href={`/products/${item.slug}/`}>View specification <span aria-hidden="true">-></span></a>
            </article>
          ))}
        </div>
      </section>
    )}

    <RfqPanel sku={product.sku} />
  </main>
</BaseLayout>
