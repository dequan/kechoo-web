---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy policy" description="Band Saw Blade Supply privacy policy for inquiry and quotation contact data.">
  <main id="main-content">
    <article class="page-hero">
      <nav class="breadcrumbs"><a href="/">Home</a> / Privacy</nav>
      <h1>Privacy policy</h1>
      <p>Band Saw Blade Supply collects inquiry details such as name, company, email, WhatsApp, destination country and product requirements only to respond to quotation and supply requests.</p>
      <p>Inquiry data may be used for sales communication, quotation preparation, shipping discussion and customer support. Band Saw Blade Supply does not sell inquiry contact data.</p>
    </article>
  </main>
</BaseLayout>
