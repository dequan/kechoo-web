---
import type { Product } from '../data/products';
import { applications, technologies } from '../data/site';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const application = applications.find((item) => item.slug === product.application);
const technology = technologies.find((item) => item.slug === product.technology);
---

<article class="product-card">
  <div class="product-card__meta">
    <span>{technology?.title}</span>
    <span>{application?.title}</span>
  </div>
  <h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3>
  <p class="product-card__market">{product.marketTitle}</p>
  <p class="product-card__summary">{product.selectionRationale}</p>
  <dl class="spec-list spec-list--compact">
    <div><dt>SKU</dt><dd>{product.sku}</dd></div>
    <div><dt>Size</dt><dd>{product.length} x {product.width} x {product.thickness}</dd></div>
    <div><dt>Imperial</dt><dd>{product.imperialSize}</dd></div>
    <div><dt>Tooth pitch</dt><dd>{product.toothPitch}</dd></div>
    <div><dt>Cutting range</dt><dd>{product.cutMaterial}</dd></div>
  </dl>
  <a class="text-link" href={`/request-a-quote/?sku=${product.sku}`}>Ask for price and lead time <span aria-hidden="true">-></span></a>
</article>
