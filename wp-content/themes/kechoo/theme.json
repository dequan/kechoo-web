{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultGradient": false,
      "palette": [
        { "slug": "calibrated-oxide", "name": "Calibrated Oxide", "color": "#B51D24" },
        { "slug": "deep-cut-red", "name": "Deep Cut Red", "color": "#8E151B" },
        { "slug": "machine-graphite", "name": "Machine Graphite", "color": "#1B2226" },
        { "slug": "inspection-white", "name": "Inspection White", "color": "#FFFFFF" },
        { "slug": "workshop-gray", "name": "Workshop Gray", "color": "#F1F3F3" },
        { "slug": "fresh-cut-steel", "name": "Fresh-Cut Steel", "color": "#B9C0C2" },
        { "slug": "technical-ink", "name": "Technical Ink", "color": "#5A6469" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "spacing": {
      "units": ["px", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "xs", "name": "XS", "size": "0.5rem" },
        { "slug": "sm", "name": "S", "size": "0.75rem" },
        { "slug": "md", "name": "M", "size": "1rem" },
        { "slug": "lg", "name": "L", "size": "1.5rem" },
        { "slug": "xl", "name": "XL", "size": "2rem" },
        { "slug": "2xl", "name": "2XL", "size": "3rem" },
        { "slug": "3xl", "name": "3XL", "size": "4rem" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "barlow",
          "name": "Barlow",
          "fontFamily": "Barlow, Arial Narrow, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "1.75rem" },
        { "slug": "display", "name": "Display", "size": "clamp(3rem, 6vw, 5.75rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#1B2226"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|barlow",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": { "radius": "0" },
        "color": { "background": "#B51D24", "text": "#FFFFFF" },
        "typography": { "fontWeight": "700" }
      },
      "heading": {
        "typography": { "fontWeight": "800", "lineHeight": "1.08" }
      },
      "link": {
        "color": { "text": "#8E151B" }
      }
    }
  }
}

